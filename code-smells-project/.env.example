# Session signing key. Generate a random value per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Debug mode. Absent or empty means disabled.
DEBUG=false

HOST=127.0.0.1
PORT=5000

DB_PATH=loja.db

# Token required in the X-Admin-Token header by the /admin/* routes.
# Leaving it empty keeps the administrative routes unavailable.
ADMIN_TOKEN=

# Origins allowed by CORS, comma separated.
# Empty blocks everything outside development mode.
CORS_ORIGINS=http://localhost:3000

PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
