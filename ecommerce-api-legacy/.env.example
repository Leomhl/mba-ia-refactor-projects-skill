NODE_ENV=development
PORT=3000

# SQLite file path. ":memory:" keeps the database volatile,
# recreated on every boot with the sample data.
DB_PATH=:memory:

# Driver verbose mode: attaches a stack trace to errors.
# Keep it disabled outside development.
DB_VERBOSE=false

# Payment gateway key. Without a value, checkout is refused.
PAYMENT_GATEWAY_KEY=

# bcrypt-equivalent cost for password hashing.
BCRYPT_ROUNDS=12

# Token required in the X-Admin-Token header by the /api/admin/* routes
# and by destructive operations.
ADMIN_TOKEN=

LOG_LEVEL=info
