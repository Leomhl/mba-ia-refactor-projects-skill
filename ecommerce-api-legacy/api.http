@baseUrl = http://localhost:3000
# Same value set in ADMIN_TOKEN in .env
@adminToken = token-de-teste

### Checkout - success
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - payment declined
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Administrative financial report
# Now requires a token: the endpoint exposed revenue and student data
# to any anonymous request.
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Financial report without a token (expected 401)
GET {{baseUrl}}/api/admin/financial-report

### Deactivate user
# Deletion is now logical: removing the row left enrollments and
# payments orphaned, corrupting the financial report.
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
